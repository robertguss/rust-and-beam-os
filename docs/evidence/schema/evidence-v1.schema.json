{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-beam.invalid/schema/evidence-v1.schema.json",
  "title": "Rust + BEAM evidence receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "task",
    "recorded_at",
    "claim",
    "classification",
    "build",
    "command",
    "environment",
    "inputs",
    "artifacts",
    "result"
  ],
  "properties": {
    "schema": { "const": "rust-beam/evidence/v1" },
    "id": { "type": "string", "pattern": "^RB-EV-[A-Z0-9-]+$" },
    "task": { "type": "string", "pattern": "^RB-[A-Z]+-[A-Z0-9]+$" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "claim": { "type": "string", "minLength": 1 },
    "classification": {
      "enum": ["scaffold", "host", "smoke", "target"]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_revision", "source_dirty", "target"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rb1-[0-9a-f]{12}-(clean|dirty)-[0-9]{8}T[0-9]{6}Z$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_dirty": { "type": "boolean" },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "tools"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "inputs": { "$ref": "#/$defs/files" },
    "artifacts": { "$ref": "#/$defs/files" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exit_code"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    }
  },
  "$defs": {
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
